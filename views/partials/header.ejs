<button class="sidebar-toggle" type="button" aria-label="Toggle menu"
  onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>

<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">JobLink<span>Cameroon</span></a>

  <nav>
    <% if (currentUser) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/jobs">Jobs</a>
      <% if (currentUser.role === ROLES.EMPLOYER) { %>
        <a href="/jobs/mine">My listings</a>
      <% } else if (currentUser.role === ROLES.JOBSEEKER) { %>
        <a href="/applications">My applications</a>
      <% } %>
      <a href="/profile">My profile</a>
    <% } else { %>
      <a href="/jobs">Jobs</a>
      <a href="/login">Sign in</a>
      <a href="/register">Register</a>
    <% } %>
  </nav>

  <% if (currentUser) { %>
    <form action="/logout" method="POST" class="sidebar-signout">
      <button type="submit" class="link-button">Sign out</button>
    </form>
  <% } %>
</aside>

<div class="app-content">
<main>
<%- include('flash') %>