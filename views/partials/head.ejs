  // this is an extra that tells google to use Public sans font for the website and will be called in css as font-family: 'Public Sans', sans-serif;
  <link rel="preconnect" href="https://fonts.googleapis.com"> //this tells the browser to establish a connection to the Google Fonts server before it actually needs to fetch the font files. This can help improve performance by reducing the time it takes to load the fonts when they are requested later in the page.
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> // The first provides the CSS information about the font, while the second commonly serves the actual font files.
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">//Loads the Public Sans font from Google Fonts
  <link rel="stylesheet" href="/css/style.css">
