<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="form-page">
  <h1>CREATE ACCOUNT</h1>

  <form action="/register" method="POST" novalidate>
    <fieldset class="roles">
      <legend>Choose your role</legend>
      <label class="role-option">
        <input type="radio" name="role" value="<%= roles.JOBSEEKER %>"
          <%= formData.role === roles.EMPLOYER ? '' : 'checked' %>>
        <span>I am looking for a job opportunity/internship</span>
      </label>
      <label class="role-option">
        <input type="radio" name="role" value="<%= roles.EMPLOYER %>"
          <%= formData.role === roles.EMPLOYER ? 'checked' : '' %>>
        <span>I am hiring</span>
      </label>
    </fieldset>

    <div class="role-fields" data-role="<%= roles.JOBSEEKER %>">
      <label for="name">Full name</label>
      <input id="name" name="name" type="text" value="<%= formData.name || '' %>">
    </div>

    <div class="role-fields" data-role="<%= roles.EMPLOYER %>">
      <label for="companyName">Company or organisation</label>
      <input id="companyName" name="companyName" type="text" value="<%= formData.companyName || '' %>">

      <label for="location">Location</label>
      <input id="location" name="location" type="text" list="locations" value="<%= formData.location || '' %>">
      <datalist id="locations">
        <% locations.forEach(function (loc) { %><option value="<%= loc %>"><% }); %>
      </datalist>
    </div>

    <label for="username">Username</label>
    <input id="username" name="username" type="text" value="<%= formData.username || '' %>" required>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= formData.email || '' %>" required>

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>
    <p class="hint">At least 8 characters.</p>

    <label for="confirmPassword">Repeat password</label>
    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required>

    <button type="submit" class="button">Create account</button>
  </form>
  <p class="aside">Already registered? <a href="/login">Sign in</a>.</p>
</section>
// to decide which role fields to show based on the selected role, and hide the others. It also initializes the visibility of the role fields when the page loads.
<script>
  const radios = document.querySelectorAll('input[name="role"]');
  const groups = document.querySelectorAll('.role-fields');
  function syncRoleFields() {
    const selected = document.querySelector('input[name="role"]:checked').value;
    groups.forEach((g) => { g.hidden = g.dataset.role !== selected; });
  }
  radios.forEach((r) => r.addEventListener('change', syncRoleFields));
  syncRoleFields();
</script>

<%- include('../partials/footer') %>