<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="page-header">
  <h1>My listings</h1>
  <a class="button" href="/jobs/new">Post a job</a>
</div>

<% if (!jobs.length) { %>
  <p class="empty">You haven't posted anything yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Title</th><th>Location</th><th>Status</th><th>Deadline</th><th></th></tr>
    </thead>
    <tbody>
      <% jobs.forEach(function (job) { %>
        <tr>
          <td><a href="/jobs/<%= job._id %>"><%= job.title %></a></td>
          <td><%= job.location %></td>
          <td><span class="pill pill-<%= job.status %>"><%= job.status %></span></td>
          <td><%= job.deadline.toDateString() %></td>
          <td>
            <a href="/jobs/<%= job._id %>/edit">Edit</a>
            <form action="/jobs/<%= job._id %>?_method=DELETE" method="POST" class="inline"
              onsubmit="return confirm('Remove this listing?');">
              <button type="submit" class="link-button">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>