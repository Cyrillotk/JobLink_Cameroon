const mongoose = require("mongoose");

const jobSchema = new mongoose.Schema(
    {
        name: {
            type: String,
            required: true,
            trim: true
        },

        description: {
            type: String,
            required: true,
            trim: true
        },

        location: {
            type: String,
            required: true,
            trim: true
        },

        requirements: {
            type: [String],
            default: []
        }
    },
    {
        timestamps: true
    }
);

const Job = mongoose.model("Job", jobSchema);
module.exports = Job;